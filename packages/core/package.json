{
  "name": "@map-editor/core",
  "version": "0.1.0",
  "description": "Núcleo headless del editor vectorial sobre MapLibre: edición, snapping, importación/exportación y autoguardado.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "maplibre-gl": "^6.0.0"
  },
  "dependencies": {
    "@tmcw/togeojson": "^7.1.4",
    "flatgeobuf": "^4.6.1",
    "idb-keyval": "^6.3.0",
    "jszip": "^3.10.2",
    "proj4": "^2.23.0",
    "rbush": "^4.0.1",
    "sql.js": "^1.17.0"
  },
  "optionalDependencies": {
    "gdal3.js": "^2.8.1"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/proj4": "^2.19.0",
    "@types/rbush": "^4.0.0",
    "@types/sql.js": "^1.16.1",
    "@xmldom/xmldom": "^0.9.8",
    "fake-indexeddb": "^6.0.0",
    "maplibre-gl": "^6.19.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.2"
  }
}
