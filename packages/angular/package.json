    "@angular/core": "~22.3.0",
    "@angular/platform-browser": "~22.3.0",
    "@map-editor/core": "workspace:*",
    "@map-editor/web-component": "workspace:*",
    "maplibre-gl": "^6.19.0",
    "ng-packagr": "~22.3.0",
